---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Read stories created with StoryTeller Agents' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | StoryTeller</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📖</text></svg>" />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('st-theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
        // Detect Kindle / Silk / basic e-ink browsers and flag for simplified styling.
        // These browsers have poor CSS support: no backdrop-filter, slow transitions, broken SVG sizing.
        var ua = navigator.userAgent || '';
        if (/Kindle|Silk|KFTT|KFOT|KFJWI|KFJWA|KFTHWI|KFTHWA|KFAPWI|KFAPWA|KFARWI|KFASWI|KFASWI|KFSOWI|KFDOWI/i.test(ua)) {
          document.documentElement.setAttribute('data-kindle', 'true');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <slot />
  </body>
</html>
