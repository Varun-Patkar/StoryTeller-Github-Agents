---
/**
 * Brain Viewer page — /brain/<slug>/ — renders the interactive knowledge-graph viewer
 * for one story. Static route: one page is generated per book that has a graph.
 */
import Base from '../../layouts/Base.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import BrainViewer from '../../components/BrainViewer.astro';
import { getBook } from '../../lib/books';
import { getGraphSlugs } from '../../lib/graph';

export function getStaticPaths() {
  return getGraphSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const book = getBook(slug!);
const base = import.meta.env.BASE_URL;
const title = book?.config.title || slug!;
---

<Base title={`Brain · ${title}`} description={`Knowledge graph for ${title}`}>
  <header class="border-b border-neutral-200 dark:border-neutral-800">
    <div class="max-w-full mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
      <a href={`${base}book/${slug}/`} class="flex items-center gap-2 text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{title}</span>
      </a>
      <div class="flex items-center gap-3">
        <span class="text-sm font-medium text-neutral-400">Brain</span>
        <ThemeToggle />
      </div>
    </div>
  </header>

  <BrainViewer slug={slug!} />
</Base>
