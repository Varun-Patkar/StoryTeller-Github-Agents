---
import Base from '../../../../layouts/Base.astro';
import ReaderSettings from '../../../../components/ReaderSettings.astro';
import { getBooks, getBook, getSections, getSectionContent } from '../../../../lib/books';
import { marked } from 'marked';

export function getStaticPaths() {
  const books = getBooks();
  const paths: { params: { slug: string; num: string }; props: { bookTitle: string } }[] = [];

  for (const book of books) {
    const sections = getSections(book.slug);
    for (const sec of sections) {
      paths.push({
        params: { slug: book.slug, num: sec.key },
        props: { bookTitle: book.config.title || book.slug },
      });
    }
  }

  return paths;
}

const { slug, num } = Astro.params;
const { bookTitle } = Astro.props;
const base = import.meta.env.BASE_URL;

const sections = getSections(slug!);
const index = sections.findIndex(s => s.key === num);
const current = index >= 0 ? sections[index] : null;
const content = current ? getSectionContent(slug!, num!) : null;

if (!content || !current) {
  return Astro.redirect(`${base}book/${slug}/`);
}

const html = marked.parse(content) as string;

const prev = index > 0 ? sections[index - 1] : null;
const next = index < sections.length - 1 ? sections[index + 1] : null;
const total = sections.length;
const position = index + 1;
---

<Base title={`${current.heading} — ${bookTitle}`}>
  <!-- Top bar -->
  <div class="sticky top-0 z-20 border-b border-neutral-200/60 dark:border-neutral-800/60 backdrop-blur-md bg-neutral-50/80 dark:bg-neutral-950/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between">
      <a
        href={`${base}book/${slug}/`}
        class="flex items-center gap-2 text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors"
      >
        <svg class="w-4 h-4" width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span class="hidden sm:inline truncate max-w-[200px]">{bookTitle}</span>
        <span class="sm:hidden">Back</span>
      </a>

      <span class="text-xs text-neutral-400 dark:text-neutral-500">
        {position} / {total}
      </span>

      <!-- Settings button only — panel rendered outside backdrop-filter container -->
      <button
        id="settings-toggle"
        class="p-2 rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
        aria-label="Reading settings"
      >
        <svg class="w-5 h-5" width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Settings panel and backdrop — OUTSIDE the top bar to avoid backdrop-filter containing block issue -->
  <ReaderSettings />

  <!-- Reader content -->
  <main id="reader-content" class="mx-auto py-8 sm:py-12" style="max-width: 95vw; font-family: 'Georgia', 'Times New Roman', serif; font-size: 18px; line-height: 1.8;">
    <!-- Section title -->
    <h1 class="font-bold mb-8 sm:mb-12 text-center leading-tight" style="font-size: 1.5em;">
      {current.heading}
    </h1>

    <!-- Prose -->
    <div class="reader-prose" set:html={html} />

    <!-- Bottom navigation -->
    <nav class="flex items-center justify-between py-8 mt-8 border-t border-neutral-200 dark:border-neutral-800">
      {prev ? (
        <a
          href={`${base}book/${slug}/chapter/${prev.key}/`}
          class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2.5 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <svg class="w-4 h-4" width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="hidden sm:inline">Previous</span>
          <span class="sm:hidden">Prev</span>
        </a>
      ) : (
        <div></div>
      )}

      <span class="text-xs text-neutral-400">{position} / {total}</span>

      {next ? (
        <a
          href={`${base}book/${slug}/chapter/${next.key}/`}
          class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2.5 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          <span class="hidden sm:inline">Next</span>
          <span class="sm:hidden">Next</span>
          <svg class="w-4 h-4" width="16" height="16" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ) : (
        <a
          href={`${base}book/${slug}/`}
          class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2.5 rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
        >
          Back to Book
        </a>
      )}
    </nav>
  </main>

  <!-- Keyboard navigation -->
  <script define:vars={{ base, slug, prevKey: prev?.key ?? null, nextKey: next?.key ?? null }}>
    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (e.key === 'ArrowLeft' && prevKey) {
        window.location.href = `${base}book/${slug}/chapter/${prevKey}/`;
      } else if (e.key === 'ArrowRight' && nextKey) {
        window.location.href = `${base}book/${slug}/chapter/${nextKey}/`;
      }
    });
  </script>
</Base>
