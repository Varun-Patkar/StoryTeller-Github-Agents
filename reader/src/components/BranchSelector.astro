---
import { getBranchTargets } from '../lib/branches';

const rootBase = import.meta.env.PUBLIC_ROOT_BASE || import.meta.env.BASE_URL;
const currentBranch = import.meta.env.PUBLIC_BRANCH_NAME || 'main';
const targets = getBranchTargets(rootBase);
const indicatorClass = currentBranch === 'main' ? 'bg-emerald-500' : 'bg-amber-500';
---

<div class="border-b border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900">
  <div class="mx-auto flex h-9 max-w-6xl items-center justify-end gap-2 px-4 sm:px-6">
    <span class:list={['h-1.5 w-1.5 rounded-full', indicatorClass]} aria-hidden="true"></span>
    <label for="branch-select" class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">
      Branch
    </label>
    <select
      id="branch-select"
      data-branch-select
      class="h-7 max-w-52 rounded-md border border-neutral-300 bg-neutral-50 px-2 text-xs font-medium text-neutral-800 outline-none focus:border-neutral-500 dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-200"
      aria-label="Published branch"
    >
      {targets.map(target => (
        <option value={target.href} selected={target.name === currentBranch}>
          {target.name}
        </option>
      ))}
    </select>
  </div>
</div>

<script>
  document.querySelector('[data-branch-select]')?.addEventListener('change', (event) => {
    const select = event.currentTarget;
    if (select instanceof HTMLSelectElement) window.location.assign(select.value);
  });
</script>